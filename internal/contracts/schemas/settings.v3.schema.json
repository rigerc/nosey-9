{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nosey:schema:settings:v3",
  "title": "Nosey settings v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "registries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registrySetting"
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "method": {
          "enum": [
            "symlink",
            "copy"
          ]
        },
        "verbose": {
          "type": "boolean"
        },
        "customAgents": {
          "type": "array",
          "description": "User config only: custom agents with workspace-relative skill directories. Semantic validator enforces unique IDs, no collision with built-in agent IDs and a local skillsDir.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "skillsDir"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "skillsDir": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Workspace-relative skills directory; must stay inside the workspace."
              }
            }
          }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "adapters": {
          "type": "array",
          "description": "User config only: trusted adapters; project config cannot enable. Semantic validator enforces scope and hash integrity.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256",
              "path",
              "enabled"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute user-level installed adapter location (semantic validator verifies containment)."
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "enableMcpPackage": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to passive inspection of supported workspace MCP server configuration files for mcp_package rules. No MCP process is started."
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fullscreen",
            "inline"
          ]
        },
        "collapseRepos": {
          "type": "boolean",
          "default": false,
          "description": "Start repository groups collapsed in Scan and Explore results."
        }
      }
    }
  },
  "$defs": {
    "registrySetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "const": "git"
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_./-]*|https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]+)?/[A-Za-z0-9._~%/?=&+\\-]+|ssh://(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9.-]*/[A-Za-z0-9._/-]+|git@[A-Za-z0-9][A-Za-z0-9.-]*:[A-Za-z0-9._/-]+)$",
                  "maxLength": 2048
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "maxLength": 200
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "const": "local"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?:~/?|/|[A-Za-z0-9_.-])[A-Za-z0-9_./-]*$",
                  "description": "Project config: workspace-root-relative or absolute; user config: absolute or ~/ path (enforced by semantic validator)."
                }
              }
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "ttlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "description": "Overrides updates.ttlHours for this registry only."
        }
      }
    }
  }
}
