   "files": [
    {
     "path": "skill/SKILL.md",
     "content": "---\nname: copy-probe\ndescription: Copy probe\n---\n# P\n"
    },
    {
     "path": "skill/sub/y.txt",
     "content": "y\n"
    },
    {
     "path": "skill/sub/loop",
     "symlink": ".."
