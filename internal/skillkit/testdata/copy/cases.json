   "files": [
    {
     "path": "skill/SKILL.md",
     "content": "---\nname: copy-probe\ndescription: Copy probe\n---\n# P\n"
    },
    {
     "path": "skill/metadata.json",
     "content": "{}\n"
    },
    {
     "path": "skill/sub/metadata.json",
     "content": "{}\n"
    },
    {
     "path": "skill/.git/HEAD",
     "content": "ref\n"
    },
    {
     "path": "skill/__pycache__/m.pyc",
     "content": "x\n"
    },
    {
     "path": "skill/__pypackages__/p.txt",
     "content": "x\n"
    },
    {
     "path": "skill/node_modules/m/i.js",
     "content": "x\n"
    },
    {
     "path": "skill/keep.txt",
     "content": "k\n"
    }
   ],
   "expect": [
    "f SKILL.md 644",
