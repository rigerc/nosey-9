{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nosey:schema:doctor-output:v1",
  "title": "Nosey doctor-output output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outputVersion",
    "diagnostics",
    "workspace",
    "checks"
  ],
  "properties": {
    "outputVersion": {
      "const": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      }
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "code",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warning",
              "fail"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
